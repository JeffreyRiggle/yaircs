
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C",
      "type": "process",
      "command": "clang",
      "args": [
        "-std=c11",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "${workspaceFolder}/main.c",
        "-o",
        "${workspaceFolder}/irc-server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
